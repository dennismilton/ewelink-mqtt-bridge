# Copy to .env on the Pi (never commit .env — DEVICE_KEY / secrets live only there).
DEVICE_ID=10013c5fde
DEVICE_KEY=your-device-key-from-ewelink-cloud
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
TOPIC_PREFIX=maracaibo/sonoff/powr3

# --- Cloud read for power/V/A (POWR3 doesn't report these reliably over LAN) ---

# Preferred: eWeLink OAuth2.0 app (dev.ewelink.cc license). Run once:
#   docker compose run --rm sonoff-powr3 python powr3_lan.py auth
# Tokens persist in ./data/ewelink_tokens.json and auto-refresh (at 30d / rt 60d).
EWELINK_APPID=your-oauth-appid
EWELINK_APPSECRET=your-oauth-appsecret
# Must exactly match the redirect URL registered with the OAuth app:
EWELINK_REDIRECT_URL=http://127.0.0.1:8000/callback
EWELINK_TOKEN_FILE=/data/ewelink_tokens.json

# Legacy fallback: manually-made access token (used if OAuth tokens absent/broken).
# EWELINK_TOKEN=your-ewelink-accessToken
# EWELINK_TOKEN_APPID=K0OCDSvIaBWdEaU4zxlKEwk26kmshoXK

EWELINK_REGION=eu
CLOUD_INTERVAL=30
